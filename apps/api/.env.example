# Copy to .env for local development. Never commit real values.
KORI_ENV=development
KORI_LOG_LEVEL=INFO
# Required when KORI_ENV=production
# KORI_APP_ORIGIN=https://kori.example.com

# Postgres (used by compose.yaml and the API). The test suite uses "<db>_test" on the same server.
POSTGRES_USER=kori
POSTGRES_PASSWORD=kori
POSTGRES_DB=kori
KORI_DATABASE_URL=postgresql+psycopg://kori:kori@localhost:5432/kori
